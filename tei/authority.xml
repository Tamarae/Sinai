  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title xml:lang="ka">სინური მრავალთავი — საავტორო სია</title>
        <title xml:lang="en">Sinai Mravaltavi — Authority List</title>
      </titleStmt>
      <publicationStmt>
        <authority>ილიას სახელმწიფო უნივერსიტეტი, ლინგვისტურ კვლევათა ინსტიტუტი</authority>
        <availability>
          <licence target="https://creativecommons.org/licenses/by-nc-sa/4.0/"/>
        </availability>
      </publicationStmt>
      <sourceDesc>
        <p>პერსონები და ადგილები სინური მრავალთავის (864 წ.) ტექსტებში.</p>
      </sourceDesc>
    </fileDesc>
  </teiHeader>

  <!--
    TYPE TAXONOMY
    ═══════════════════════════════════════════════════════
    Persons (@type on <person>):
      divinity      — ღმერთი, ქრისტე, სული წმიდა
      theotokos     — ღვთისმშობელი მარიამი (special category in Georgian homiletics)
      archangel     — გაბრიელ, მიქაელ
      apostle       — 12 მოციქული + პავლე
      martyr        — მოწამეები
      prophet       — ძველი აღთქმის წინასწარმეტყველები
      father        — საეკლესიო მამები
      biblical      — სხვა ბიბლიური პერსონები

    Places (@type on <place>):
      city / region / sacred / monastery

    ENCODING IN TEXTS
    ═══════════════════════════════════════════════════════
    <persName ref="#pers-stepane">სტეფანე</persName>
    <placeName ref="#place-ierusalemi">იერუსალემი</placeName>

    VIAF IDs: all marked cert="medium" — verify at https://viaf.org
  -->


  <text>
    <body>
      <div type="text" xml:id="mrav-bound-ioane-zosime-body">
        <pb n="312v" ed="#S" facs="https://tile.loc.gov/image-services/iiif/service:amed:amedmonastery:00279386887-ms:0314/full/pct:100/0/default.jpg"/>
        
        <head type="invocation">
          <hi rend="initial">Ⴉ</hi>̃სნ სახელითა ღმრთისაჲთა
        </head>
        
        <p xml:id="p1" n="1">
          <hi rend="initial">Ⴘ</hi>ეიმოსა მესამედ წმიდაჲ ესე წიგნი მრავალთავი <w lemma="#lex-tqavi">ტყავითა</w> ზროხისაჲთა <note n="1">1*</note> <placeName ref="#place-sina">სინა</placeName>-წმიდას ჴელითა იოვანე <note n="2">2*</note> <w lemma="#lex-priad">ფრიად</w> ცოდვილისა <note n="3">3*</note> ზოსიმესითა დღეთა <w lemma="#lex-oden">ოდენ</w> ბოროტად <w lemma="#lex-mokhutsebuloba">მოხუცებულობისა</w> ჩემისათა, ბრძანებითა და <w lemma="#lex-priad">ფრიად</w> მოსწრაფედ მოღუაწებითა <persName ref="#pers-mikael">მიქაელ</persName> და <persName ref="#pers-mikael">მიქაელ</persName> პატიოსანთა მღდელთაჲთა, დასაბამითგანთა წელთა ქართულად: ხ̂ფპე-სა და ქრონიკონსა: ს̂ა-სა.
        </p>
        
        <p xml:id="p2" n="2">
          <hi rend="initial">Ⴀ</hi>წ გევედრებით თქუენ, ყოველთა ღმრთის მოყუარეთა <w lemma="#lex-mama">მამათა</w> და <w lemma="#lex-dzma">ძმათა</w> ჩუენთა, გვედიეთ წმიდასა <w lemma="#lex-lotsva">ლოცვასა</w> თქუენსა მე <w lemma="#lex-priad">ფრიად</w> ცოდვილი იოვანე <note n="4">4*</note> და <persName ref="#pers-mikhael">მიქაელ</persName> <note n="5">5*</note> და <persName ref="#pers-mikhael">მიქაელ</persName> <note n="6">5*</note> და მშობელნი და <w lemma="#lex-dzma">ძმანი</w> ჩუენნი და ყოველნივე <w lemma="#lex-chueneuli">ჩუენეულნი</w>, ცოცხალნი და მიცვალებულნი, სულიერნი და ჴორციელნი, <w lemma="#lex-rametu">რამეთუ</w> ჩუენ <w lemma="#lex-priad">ფრიად</w> გურწამს თქუენი <w lemma="#lex-lotsva">ლოცვაჲ</w> და ყოველი დაკლებული ჩუენი შეგჳნდვეთ <note n="7">6*</note> ღმრთისათჳს, და თქუენცა ქრისტემან შეგინდვენ და შეგიწყალენინ ყოველნი. <w lemma="#lex-amen">ამენ</w> <note n="8">7*</note>.
        </p>
        
        <p xml:id="p3" n="3">
          <hi rend="initial">Ⴕ</hi><persName ref="#pers-iesu-kriste">რისტე</persName>, შეიწყალე <persName ref="#pers-mikhael">მიქაელ</persName> <note n="9">5*</note> და <persName ref="#pers-mikhael">მიქაელ</persName> <note n="10">8*</note>, <persName ref="#pers-gabriel">გაბრიელ</persName> <note n="11">9*</note>, <persName ref="#pers-kwrike">კჳრიკე</persName> <note n="12">10*</note>, გიორგი <note n="13">11*</note>, იოანე-ზოსიმე <note n="14">12*</note> და ყოველნი <w lemma="#lex-dzma">ძმანი</w> და ყოველნი ქრისტეანენი და <w lemma="#lex-upro">უფროჲს</w> ყოველთასა ყოველნი ქართველნი.
        </p>
        
        <p xml:id="p4" n="4">
          <hi rend="initial">Ⴊ</hi><w lemma="#lex-lotsva">ოცვა</w>-ყავთ ჩუენთჳს, წმიდანო (მამანო), <w lemma="#lex-lotsva">ლოცვა</w>-ყავთ! <w lemma="#lex-amen">ამენ</w> <note n="15">7*</note>.
        </p>
        
      </div>
    </body>
